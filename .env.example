# Create a separate reporting Telegram bot with BotFather; do not reuse the news bot token.
REPORT_TG_BOT_TOKEN=
# Private Telegram user ID allowed to open dashboard and receive 09:00 reports.
REPORT_CHAT_ID=
# Optional other allowed Telegram IDs, comma separated (they must press /start).
ALLOWED_USER_IDS=

# Same VPS as sinai-news-bot2. Path is relative to THIS project's directory.
SOURCE_DATABASE_PATH=../sinai-news-bot2/data/sinai.sqlite3
AMOCRM_BASE_URL=https://sinai24.amocrm.ru
# Optional if the source bot stores its active OAuth token in settings.oauth.
AMOCRM_ACCESS_TOKEN=

TIMEZONE=Asia/Krasnoyarsk
DAILY_REPORT_TIME=09:00
CACHE_TTL_SECONDS=900
CRM_WORKERS=4
# Set exact amoCRM field ID if several fields are called "Менеджер".
MANAGER_FIELD_ID=0
REPORT_STATE_PATH=data/report_state.sqlite3
LOG_LEVEL=INFO
